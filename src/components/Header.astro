---
import { withBase } from '../config/url';
// One set of labels everywhere: desktop, phone menu and footer. Links are absolute so they work from
// every page; on the page that holds the target, site.ts turns them into smooth in-page scrolls.
interface Props { current?: 'home' | 'judo' }
const { current = 'home' } = Astro.props;
const nav = [[withBase('/#inicio'), 'Inicio'], [withBase('/el-judo/'), 'El judo', 'judo'], [withBase('/#programas'), 'Programas'], [withBase('/#informacion'), 'Información'], [withBase('/#preguntas'), 'Preguntas'], [withBase('/el-judo/#sensei'), 'Sensei']];
const mobileNav = nav;
---
<a class="skip" href={withBase('/#inscripcion')}>Saltar a la inscripción</a>

<header class="hdr" data-header>
  <a class="hdr__brand" href={withBase('/')} aria-label="Club Deportivo de Judo Hikawa, inicio">
    <img src={withBase('/assets/hikawa-logo-88.webp')} alt="" width="44" height="44" />
    <span class="hdr__words">
      <span class="hdr__name">HIKAWA</span>
      <span class="hdr__sub">CLUB DEPORTIVO DE JUDO</span>
    </span>
  </a>
  <nav class="hdr__nav" aria-label="Principal">
    {nav.map(([href, label, page]) => <a href={href} data-spy aria-current={page && page === current ? 'page' : undefined}>{label}</a>)}
  </nav>
  <div class="hdr__actions">
    <a class="btn btn--red hdr__cta" href={withBase('/#inscripcion')} data-magnetic>INSCRÍBETE</a>
    <button class="hdr__burger" type="button" aria-expanded="false" aria-controls="menu-movil" aria-label="Abrir menú" data-menu-toggle>
      <span></span><span></span>
    </button>
  </div>
</header>

<div id="menu-movil" class="menu" aria-hidden="true" data-menu>
  <nav aria-label="Menú móvil">
    {mobileNav.map(([href, label, page], i) => <a href={href} data-menu-link data-spy style={`--i:${i}`} aria-current={page && page === current ? 'page' : undefined}>{label}</a>)}
  </nav>
  <a class="btn btn--ink btn--lg menu__cta" href={withBase('/#inscripcion')} data-menu-link>QUIERO ENTRENAR <span class="arrow" aria-hidden="true">→</span></a>
</div>

<button type="button" class="totop" aria-label="Volver arriba" data-totop>
  <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true"><path d="M12 19V5M5 12l7-7 7 7" fill="none" stroke="currentColor" stroke-width="2.5" /></svg>
</button>

<style>
  .hdr {
    position: fixed; inset: 0 0 auto; z-index: 50; height: var(--header-h);
    display: flex; align-items: center; justify-content: space-between; gap: 24px;
    padding: 0 var(--margin); color: var(--white);
    background: rgba(10, 10, 10, 0); transition: background-color 300ms ease;
  }
  .hdr.is-solid, :global(.menu-open) .hdr { background: var(--black); }
  .hdr__brand { display: flex; align-items: center; gap: 12px; flex: none; }
  .hdr__brand img { width: 44px; height: 44px; border-radius: 50%; background: #fff; }
  .hdr__words { display: flex; flex-direction: column; line-height: 1; gap: 4px; }
  .hdr__name { font-family: var(--font-display); font-size: 28px; letter-spacing: 0.04em; }
  .hdr__sub { font-size: 13px; font-weight: 500; color: var(--soft-on-dark); white-space: nowrap; } /* taste-skill-ignore: brand line under the wordmark */
  .hdr__nav { display: flex; gap: clamp(18px, 2.4vw, 36px); white-space: nowrap; font-size: 15px; font-weight: 600; }
  .hdr__nav a { position: relative; padding: 10px 0; }
  .hdr__nav a::after { content: ''; position: absolute; left: 0; right: 0; bottom: 4px; height: 2px; background: var(--red); transform: scaleX(0); transform-origin: 0 50%; transition: transform var(--t-ui) var(--ease-out); }
  .hdr__nav a:hover::after, .hdr__nav a:focus-visible::after, .hdr__nav a[aria-current]::after { transform: scaleX(1); }
  .hdr__actions { display: flex; align-items: center; gap: 8px; }
  .hdr__cta { min-height: 44px; padding: 0 20px; font-size: 14px; }
  .hdr__burger { display: none; width: 44px; height: 44px; border: 0; background: var(--graphite); flex-direction: column; align-items: center; justify-content: center; gap: 6px; }
  .hdr__burger span { width: 18px; height: 2px; background: var(--white); transition: transform 300ms var(--ease-out); }
  .hdr__burger[aria-expanded='true'] span:first-child { transform: translateY(4px) rotate(45deg); }
  .hdr__burger[aria-expanded='true'] span:last-child { transform: translateY(-4px) rotate(-45deg); }

  .menu {
    position: fixed; inset: 0; z-index: 45; background: var(--red); color: var(--on-red);
    padding: calc(var(--header-h) + 28px) var(--margin) calc(28px + env(safe-area-inset-bottom));
    display: flex; flex-direction: column; justify-content: space-between; gap: 24px; overflow-y: auto; overscroll-behavior: contain;
    opacity: 0; visibility: hidden; transform: translateY(-16px);
    transition: opacity 350ms ease, transform 450ms var(--ease-out), visibility 0s linear 450ms;
  }
  .menu.is-open { opacity: 1; visibility: visible; transform: none; transition: opacity 350ms ease, transform 450ms var(--ease-out), visibility 0s; }
  .menu nav { display: flex; flex-direction: column; }
  .menu nav a { font-family: var(--font-display); font-size: clamp(44px, 12vw, 72px); line-height: 1.02; padding: 2px 0; }
  .menu nav a:active, .menu nav a[aria-current] { color: var(--black); }
  /* Links arrive one after another as the menu opens; closing stays instant. */
  @media (prefers-reduced-motion: no-preference) {
    .menu.is-open nav a, .menu.is-open .menu__cta { animation: menu-in 420ms cubic-bezier(0.23, 1, 0.32, 1) both; animation-delay: calc(80ms + var(--i, 6) * 40ms); }
  }
  @keyframes menu-in { from { opacity: 0; transform: translateY(14px); } }
  .menu__cta { width: 100%; }

  @media (max-width: 1100px) {
    .hdr__nav { display: none; }
    .hdr__burger { display: flex; }
  }
  @media (max-width: 420px) {
    .hdr__sub { display: none; }
    .hdr__cta { padding: 0 14px; }
  }
  @media (min-width: 1101px) { .menu { display: none; } }

  /* Back to top: appears after the first screen, never covers the open menu. */
  .totop {
    position: fixed; right: max(16px, calc(var(--margin) - 8px)); bottom: calc(16px + env(safe-area-inset-bottom)); z-index: 40;
    width: 52px; height: 52px; display: flex; align-items: center; justify-content: center; border: 0; border-radius: 0;
    background: var(--graphite); color: var(--white); opacity: 0; visibility: hidden; transform: translateY(12px);
    transition: opacity 240ms ease, transform 300ms cubic-bezier(0.23, 1, 0.32, 1), visibility 0s linear 300ms, background-color 180ms ease;
  }
  .totop.is-on { opacity: 1; visibility: visible; transform: none; transition: opacity 240ms ease, transform 300ms cubic-bezier(0.23, 1, 0.32, 1), visibility 0s, background-color 180ms ease; }
  .totop:active { transform: scale(0.94); }
  @media (hover: hover) and (pointer: fine) { .totop:hover { background: var(--red); } }
  :global(.menu-open) .totop { opacity: 0; visibility: hidden; }
  /* Page underneath stays put while the menu is open (iOS ignores a body-only lock). */
  :global(html.menu-open) { overflow: hidden; }
</style>

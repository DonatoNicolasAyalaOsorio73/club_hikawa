---
import { withBase } from '../config/url';
import { academy } from '../config/academy';
const panel = ['f-graphite', 'f-red', 'f-black', 'f-graphite'];
---
<section id="programas" class="prog" aria-labelledby="programas-title" data-programs>
  <div class="prog__intro field f-white">
    <h2 id="programas-title" class="head">Encuentra tu camino.</h2>
    <p class="lead">Cada programa se adapta a la edad, al nivel y a los objetivos de quien entrena. Elige el tuyo y te contactamos para coordinar la primera clase.</p>
  </div>

  <div class="prog__run" data-run>
    <div class="prog__stage">
      <img class="prog__ground" src={withBase('/posters/6254568.webp')} alt="" width="720" height="1280" loading="lazy" decoding="async" />
      <div class="prog__track" data-track>
        {academy.programs.map((p, i) => (
          <article class="prog__card">
            <div class:list={['media prog__media', { 'media--pending': !!p.media.pending }]}>
              {p.media.video ? (
                <video muted loop playsinline preload="none" poster={p.media.poster} data-loop aria-hidden="true" style={p.media.position ? `object-position:${p.media.position}` : undefined}>
                  <source src={p.media.video} type="video/mp4" />
                </video>
              ) : (
                <><span class="media__kanji" aria-hidden="true" lang="ja">柔道</span><span class="pending">[{p.media.pending}]</span></>
              )}
            </div>
            <div class:list={['prog__panel', panel[i]]}>
              <h3 class="display prog__name">{p.name}</h3>
              <div class="prog__meta">
                <p>{p.focus}</p>
                <span class="pending">{p.ages || (p.id === 'competicion' ? '[REQUISITOS · HORARIOS: POR CONFIRMAR]' : '[EDADES · HORARIOS: POR CONFIRMAR]')}</span>
                <button type="button" class="btn btn--paper" data-pick={p.name}>{p.cta} <span class="arrow" aria-hidden="true">→</span></button>
              </div>
            </div>
          </article>
        ))}
      </div>
    </div>
  </div>

  <div class="prog__compare f-black">
    <h3 class="prog__ch">Compara los programas</h3>
    <table class="prog__table">
      <thead><tr><th scope="col">Programa</th><th scope="col">Edades</th><th scope="col">Enfoque</th><th scope="col">Horario</th><th scope="col">Precio</th></tr></thead>
      <tbody>
        {academy.programs.map((p) => {
          const days = Object.entries(p.schedule).map(([d, h]) => `${d} ${h}`).join(' · ');
          return (
            <tr>
              <th scope="row" class="name">{p.name}</th>
              <td data-label="Edades">{p.ages || <span class="pending">[POR CONFIRMAR]</span>}</td>
              <td data-label="Enfoque">{p.focus}</td>
              <td data-label="Horario">{days || <span class="pending">[POR CONFIRMAR]</span>}</td>
              <td data-label="Precio">{academy.firstClass ? `Primera clase: ${academy.firstClass}` : <span class="pending">[POR CONFIRMAR]</span>}</td>
            </tr>
          );
        })}
      </tbody>
    </table>
  </div>
</section>

<style>
  .prog { position: relative; z-index: 2; }
  .prog__intro { min-height: 0; display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); column-gap: var(--gutter); row-gap: 24px; align-items: end; padding-bottom: clamp(64px, 7vw, 112px); }
  .prog__intro .head { grid-column: 1 / span 6; }
  .prog__intro .lead { grid-column: 8 / span 5; max-width: 36ch; }
  .prog__media .media__kanji { writing-mode: horizontal-tb; font-size: 22cqw; }
  @media (max-width: 1100px) { .prog__intro .head, .prog__intro .lead { grid-column: 1 / -1; } }

  /* Static layout (phones, reduced motion): the cards stack under one wide photograph. */
  .prog__run { background: var(--black); }
  .prog__stage { position: relative; padding: clamp(40px, 6vw, 80px) var(--margin) var(--field-pad); }
  .prog__ground { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; filter: grayscale(1) brightness(0.45); }
  .prog__track { position: relative; display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 320px), 1fr)); gap: 24px; }
  .prog__card { display: flex; flex-direction: column; color: var(--white); }
  .prog__media { aspect-ratio: 4 / 3; }
  .prog__panel { display: flex; flex-direction: column; gap: 16px; padding: 24px 24px 28px; flex: 1; }
  .prog__name { font-size: clamp(48px, 4.4vw, 76px); }
  .prog__meta { display: flex; flex-direction: column; align-items: flex-start; gap: 14px; }
  .prog__meta p { max-width: 34ch; }
  .prog__meta .btn { margin-top: 4px; }
  .prog__compare { padding: clamp(56px, 6vw, 96px) var(--margin) var(--field-pad); display: flex; flex-direction: column; gap: 24px; }
  .prog__ch { font-size: var(--step-lead); font-weight: 650; }
  .prog__table { width: 100%; border-collapse: collapse; }
  .prog__table thead th { text-align: left; padding: 0 16px 12px 0; font-size: var(--step-small); font-weight: 650; letter-spacing: 0.04em; color: var(--soft-on-dark); border-bottom: 3px solid var(--white); }
  .prog__table tbody th, .prog__table td { text-align: left; vertical-align: top; padding: 18px 16px 18px 0; border-bottom: 1px solid rgba(245, 245, 245, 0.18); }
  .prog__table tbody th { font-size: 20px; line-height: 1.3; }
  @media (max-width: 760px) {
    .prog__table thead { display: none; }
    .prog__table, .prog__table tbody, .prog__table tr, .prog__table th, .prog__table td { display: block; }
    .prog__table tr { padding: 18px 0; border-bottom: 1px solid rgba(245, 245, 245, 0.18); }
    .prog__table tbody th, .prog__table td { border: 0; padding: 4px 0; }
    .prog__table td::before { content: attr(data-label); display: block; font-size: var(--step-small); font-weight: 650; color: var(--soft-on-dark); }
  }

  /* Held stage: the photograph stays, the cards cross it from right to left over two screens. */
  @media (min-width: 1101px) and (prefers-reduced-motion: no-preference) {
    :global(.js) .prog__run { height: 250svh; }
    :global(.js) .prog__stage { position: sticky; top: 0; height: 100svh; overflow: clip; padding: 0; display: flex; align-items: center; }
    :global(.js) .prog__track { display: flex; gap: 40px; padding: 0 var(--margin); will-change: transform; }
    :global(.js) .prog__card { flex: 0 0 min(640px, 46vw); height: min(640px, calc(100svh - 160px)); }
    :global(.js) .prog__media { aspect-ratio: auto; flex: 0 0 52%; }
    :global(.js) .prog__panel { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.2fr); align-items: end; gap: 24px; padding: 28px; }
  }
</style>

<script>
  import { ScrollTrigger } from 'gsap/ScrollTrigger';
  const run = document.querySelector<HTMLElement>('[data-run]');
  const track = run?.querySelector<HTMLElement>('[data-track]');
  const wide = matchMedia('(min-width: 1101px) and (prefers-reduced-motion: no-preference)');
  let st: ScrollTrigger | null = null;
  const setup = () => {
    st?.kill(); st = null;
    if (!run || !track) return;
    track.style.transform = '';
    if (!wide.matches) return;
    st = ScrollTrigger.create({
      trigger: run, start: 'top top', end: 'bottom bottom', invalidateOnRefresh: true,
      onUpdate: (s) => {
        const travel = Math.max(0, track.scrollWidth - window.innerWidth);
        track.style.transform = `translate3d(${-s.progress * travel}px,0,0)`;
      },
    });
  };
  setup();
  wide.addEventListener('change', () => { setup(); ScrollTrigger.refresh(); });
</script>

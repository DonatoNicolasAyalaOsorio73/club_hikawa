---
import { techs } from '../config/academy';
const tone = ['f-red', 'f-black', 'f-white', 'f-black', 'f-white', 'f-red'];
---
<section id="tecnicas" class="tec field f-graphite" aria-labelledby="tecnicas-title" data-techs>
  <div class="tec__aside">
    <h2 id="tecnicas-title" class="head">Seis fundamentos, un mismo principio.</h2>
    <p>Máxima eficacia con el mínimo esfuerzo. Elige una técnica para ver sus puntos clave. Cada una se aprende en el tatami, con la guía del sensei.</p>
    {techs.map((t, i) => (
      <div class="tec__detail" id={`panel-${t.id}`} role="tabpanel" aria-labelledby={`tab-${t.id}`} hidden={i !== 0} tabindex="0">
        <h3 class="display tec__name">{t.name}</h3>
        <p class="tec__desc">{t.desc}</p>
        <h4 class="tec__keys-h small">PUNTOS CLAVE</h4>
        <ol class="tec__keys">
          {t.keys.map((k) => <li>{k}</li>)}
        </ol>
      </div>
    ))}
  </div>

  <div class="tec__tiles" role="tablist" aria-label="Técnicas">
    {techs.map((t, i) => (
      <button type="button" role="tab" id={`tab-${t.id}`} aria-controls={`panel-${t.id}`} aria-selected={i === 0 ? 'true' : 'false'} tabindex={i === 0 ? 0 : -1}
        class:list={['tec__tile', { 'tec__tile--wide': i === 1 }]} data-reveal style={`--i:${i}`}>
        <span class:list={['tec__specimen', tone[i]]}><span lang="ja" aria-hidden="true">{t.kanji}</span></span>
        <span class="tec__label"><span class="name">{t.name}</span><span class="small soft">{t.group}</span></span>
      </button>
    ))}
  </div>
  <p class="tec__note small soft">Fotos y clips reales de cada técnica: <span class="pending">[POR AÑADIR]</span></p>
</section>

<style>
  .tec { display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); column-gap: var(--gutter); row-gap: 40px; align-items: start; }
  .tec__aside { grid-column: 1 / span 4; display: flex; flex-direction: column; gap: 22px; position: sticky; top: calc(var(--header-h) + 32px); }
  .tec__aside > p { max-width: 36ch; color: var(--soft-on-dark); }
  .tec__aside > .head { font-size: clamp(44px, 3.9vw, 64px); }
  .tec__detail { display: flex; flex-direction: column; gap: 14px; margin-top: 18px; outline-offset: 6px; }
  .tec__detail[hidden] { display: none; }
  @media (prefers-reduced-motion: no-preference) { .tec__detail:not([hidden]) { animation: tec-in 380ms cubic-bezier(0.23, 1, 0.32, 1); } }
  @keyframes tec-in { from { opacity: 0; transform: translateY(10px); } }
  .tec__name { font-size: clamp(48px, 4.6vw, 80px); color: var(--white); }
  .tec__desc { max-width: 38ch; }
  .tec__keys-h { font-weight: 650; letter-spacing: 0.04em; color: var(--soft-on-dark); margin-top: 6px; }
  .tec__keys { counter-reset: k; display: flex; flex-direction: column; gap: 4px; }
  .tec__keys li { counter-increment: k; display: flex; gap: 16px; align-items: baseline; padding: 14px 16px; background: var(--tone-dark); }
  .tec__keys li::before { content: counter(k); font-family: var(--font-display); font-size: 28px; line-height: 1; color: var(--red); min-width: 1ch; }

  .tec__tiles { grid-column: 5 / span 8; display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 10px; row-gap: 28px; }
  .tec__tile { display: flex; flex-direction: column; gap: 12px; padding: 0; border: 0; background: none; color: inherit; text-align: left; }
  .tec__tile--wide { grid-column: span 2; }
  .tec__specimen { position: relative; display: flex; align-items: center; justify-content: center; aspect-ratio: 4 / 5; overflow: clip; min-height: 0; padding: 0; transition: transform var(--t-ui) var(--ease-out); }
  .tec__tile--wide .tec__specimen { aspect-ratio: 8 / 5; }
  .tec__specimen span { font-size: clamp(56px, 6vw, 112px); font-weight: 700; line-height: 1; writing-mode: vertical-rl; }
  .tec__tile--wide .tec__specimen span { writing-mode: horizontal-tb; }
  .tec__label { display: flex; flex-direction: column; gap: 4px; }
  .tec__tile[aria-selected='true'] .tec__specimen { box-shadow: inset 0 0 0 4px var(--red); } /* taste-skill-ignore: selection marker drawn inside the tile */
  .tec__tile[aria-selected='true'] .f-red { box-shadow: inset 0 0 0 4px var(--white); } /* taste-skill-ignore: selection marker */
  .tec__tile[aria-selected='true'] .name { text-decoration: underline; text-decoration-color: var(--red); text-decoration-thickness: 2px; text-underline-offset: 6px; }
  @media (hover: hover) and (pointer: fine) { .tec__tile:hover .tec__specimen { transform: scale(0.98); } }
  .tec__note { grid-column: 5 / span 8; }

  @media (max-width: 1100px) {
    /* Phone: heading, then the tiles, then the chosen technique right under them. */
    .tec { display: flex; flex-direction: column; align-items: stretch; gap: 24px; }
    .tec__aside { display: contents; }
    .tec__aside > .head, .tec__aside > p { order: 0; }
    .tec__tiles { order: 1; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 8px; row-gap: 22px; }
    .tec__tile--wide { grid-column: span 2; order: -1; }
    .tec__detail { order: 2; margin-top: 8px; }
    .tec__note { order: 3; }
  }
</style>

<script>
  const list = document.querySelector<HTMLElement>('[data-techs] [role="tablist"]');
  if (list) {
    const tabs = [...list.querySelectorAll<HTMLButtonElement>('[role="tab"]')];
    const select = (i: number, focus = false) => {
      tabs.forEach((t, k) => {
        const on = k === i;
        t.setAttribute('aria-selected', String(on));
        t.tabIndex = on ? 0 : -1;
        document.getElementById(t.getAttribute('aria-controls')!)!.hidden = !on;
      });
      if (focus) tabs[i].focus();
    };
    tabs.forEach((t, i) => t.addEventListener('click', () => select(i)));
    list.addEventListener('keydown', (e) => {
      const i = tabs.indexOf(document.activeElement as HTMLButtonElement);
      if (i < 0) return;
      const next = { ArrowRight: i + 1, ArrowDown: i + 1, ArrowLeft: i - 1, ArrowUp: i - 1, Home: 0, End: tabs.length - 1 }[e.key];
      if (next === undefined) return;
      e.preventDefault();
      select((next + tabs.length) % tabs.length, true);
    });
  }
</script>

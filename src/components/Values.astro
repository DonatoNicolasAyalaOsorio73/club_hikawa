---
import { values } from '../config/academy';
---
<section id="valores" class="val field f-red" aria-labelledby="valores-title" data-values>
  <div class="val__head">
    <h2 id="valores-title" class="head">El código del dojo</h2>
    <p class="lead">Seis principios que se entrenan igual que una técnica. Cada uno, con un momento real del tatami.</p>
  </div>

  <ol class="val__index">
    {values.map((v, i) => (
      <li class="val__row" tabindex="0" data-row={i} data-reveal style={`--i:${i}`}>
        <img class="val__thumb" src={`/posters/${v.video}.webp`} alt="" width="720" height="1280" loading="lazy" decoding="async" />
        <span class="display val__name">{v.name}</span>
        <div class="val__body">
          <span class="val__kanji small" lang="ja">{v.kanji}</span>
          <h3 class="val__line">{v.lines.join(' ')}</h3>
          <p class="val__text">{v.text}</p>
          <p class="small val__cap">{v.caption}</p>
          {v.cta && <a class="btn btn--ink val__cta" href="/#inscripcion" data-magnetic>EMPIEZA TU CAMINO <span class="arrow" aria-hidden="true">→</span></a>}
        </div>
      </li>
    ))}
  </ol>

  <div class="val__frame" aria-hidden="true" data-frame>
    {values.map((v, i) => (
      <video muted loop playsinline preload="none" poster={`/posters/${v.video}.webp`} data-clip={i} class:list={{ 'is-on': i === 0 }}>
        <source src={`/video/${v.video}.mp4`} type="video/mp4" />
      </video>
    ))}
  </div>
</section>

<style>
  .val { display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); column-gap: var(--gutter); align-content: start; }
  .val__head { grid-column: 1 / span 12; display: grid; grid-template-columns: subgrid; row-gap: 20px; margin-bottom: clamp(48px, 6vw, 96px); }
  .val__head .head { grid-column: 1 / span 6; }
  .val__head .lead { grid-column: 8 / span 5; align-self: end; max-width: 34ch; }
  .val__index { grid-column: 1 / span 9; display: flex; flex-direction: column; }
  .val__row { display: grid; grid-template-columns: minmax(0, 5fr) minmax(0, 4fr); column-gap: var(--gutter); align-items: start; padding: 20px 0 28px; outline-offset: 6px; transition: opacity var(--t-hover) ease; }
  .val__thumb { display: none; }
  .val__name { font-size: clamp(52px, 6.4vw, 112px); line-height: 0.86; }
  .val__body { display: flex; flex-direction: column; gap: 8px; padding-top: 6px; }
  .val__kanji { font-weight: 700; letter-spacing: 0.1em; }
  .val__line { font-size: var(--step-lead); font-weight: 650; line-height: 1.2; letter-spacing: -0.015em; }
  .val__text { max-width: 40ch; }
  .val__cap { font-weight: 600; letter-spacing: 0.02em; }
  .val__cta { align-self: flex-start; margin-top: 12px; }

  /* The preview frame is levelled with the active row; it never follows the pointer. */
  .val__frame { grid-column: 10 / span 3; grid-row: 2; position: relative; align-self: start; aspect-ratio: 4 / 5; background: var(--red-deep); overflow: clip; transition: transform 360ms var(--ease-out); }
  .val__frame video { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; opacity: 0; transition: opacity 240ms ease; filter: grayscale(1) contrast(1.15); }
  .val__frame video.is-on { opacity: 1; }

  @media (hover: hover) and (pointer: fine) {
    .val__index:has(.val__row:hover, .val__row:focus-visible) .val__row:not(:hover, :focus-visible) { opacity: 0.55; }
  }

  @media (max-width: 1100px) {
    .val__head .head, .val__head .lead { grid-column: 1 / -1; }
    .val__index { grid-column: 1 / -1; }
    .val__frame { display: none; }
    .val__row { grid-template-columns: 1fr; row-gap: 14px; padding: 22px 0 30px; }
    .val__thumb { display: block; width: 100%; height: auto; aspect-ratio: 16 / 10; object-fit: cover; filter: grayscale(1) contrast(1.15); }
    .val__name { font-size: clamp(56px, 16vw, 96px); }
  }
</style>

<script>
  const root = document.querySelector<HTMLElement>('[data-values]');
  const frame = root?.querySelector<HTMLElement>('[data-frame]');
  if (root && frame) {
    const fine = matchMedia('(hover: hover) and (pointer: fine) and (min-width: 1101px)');
    const reduced = matchMedia('(prefers-reduced-motion: reduce)');
    const rows = [...root.querySelectorAll<HTMLElement>('[data-row]')];
    const clips = [...frame.querySelectorAll<HTMLVideoElement>('video')];
    let active = 0, visible = false;
    const play = () => {
      clips.forEach((v, i) => {
        v.classList.toggle('is-on', i === active);
        if (i === active && visible && fine.matches && !reduced.matches) { v.preload = 'auto'; v.play().catch(() => {}); } else v.pause();
      });
    };
    const show = (i: number) => {
      active = i;
      // Level the frame with its row, kept inside the list.
      const first = rows[0], last = rows[rows.length - 1];
      const max = last.offsetTop + last.offsetHeight - first.offsetTop - frame.offsetHeight;
      frame.style.transform = `translateY(${Math.max(0, Math.min(max, rows[i].offsetTop - first.offsetTop))}px)`;
      play();
    };
    rows.forEach((r, i) => { r.addEventListener('pointerenter', () => show(i)); r.addEventListener('focus', () => show(i)); });
    new IntersectionObserver(([e]) => { visible = e.isIntersecting; play(); }, { rootMargin: '100px' }).observe(root);
    fine.addEventListener('change', play);
  }
</script>

---
import LogoMark from './LogoMark.astro';
const letters = ['H', 'I', 'K', 'A', 'W', 'A'];
---
<!-- Intro: the badge builds itself from a circle, then the name rises. Once per visit, skippable,
     never shown under reduced motion. The page is already rendered underneath; this only covers it. -->
<div class="ldr" aria-hidden="true" data-loader>
  <div class="ldr__stage">
    <LogoMark class="ldr__logo" />
    <p class="ldr__word display">
      {letters.map((l, i) => <span class="ldr__mask"><span style={`--i:${i}`} class:list={{ 'ldr__last': i === letters.length - 1 }}>{l}</span></span>)}
    </p>
    <p class="ldr__line">CLUB DEPORTIVO DE JUDO</p>
  </div>
  <p class="ldr__skip">Toca o desplázate para entrar</p>
</div>

<style is:global>
  /* Hidden unless the head script decided to play it (JS on, first visit, motion allowed). */
  .ldr { display: none; }
  html.js.is-loading .ldr {
    display: flex; position: fixed; inset: 0; z-index: 300; align-items: center; justify-content: center;
    background: var(--black); color: var(--white);
    clip-path: inset(0 0 0 0); transition: clip-path 760ms cubic-bezier(0.77, 0, 0.175, 1);
    /* Safety net: if the script is late (busy phone), the curtain still lifts on its own. */
    animation: ldr-out 760ms cubic-bezier(0.77, 0, 0.175, 1) 3000ms forwards;
  }
  @keyframes ldr-out { to { clip-path: inset(0 0 100% 0); visibility: hidden; } }
  html.js .ldr.is-leaving { display: flex; position: fixed; inset: 0; z-index: 300; align-items: center; justify-content: center; background: var(--black); color: var(--white); clip-path: inset(0 0 100% 0); transition: clip-path 760ms cubic-bezier(0.77, 0, 0.175, 1); pointer-events: none; }
  .ldr__stage { display: flex; flex-direction: column; align-items: center; gap: clamp(14px, 2.4vh, 24px); transition: transform 760ms cubic-bezier(0.77, 0, 0.175, 1), opacity 500ms ease; }
  .ldr.is-leaving .ldr__stage { transform: translateY(-6vh) scale(0.96); opacity: 0; }
  .ldr__logo { width: clamp(170px, 36vh, 340px); height: auto; overflow: visible; }
  .ldr__word { display: flex; font-size: clamp(64px, 10vw, 148px); line-height: 0.82; letter-spacing: 0.02em; }
  .ldr__mask { display: block; overflow: clip; padding: 0.06em 0 0.02em; }
  .ldr__mask > span { display: block; transform: translateY(108%); animation: ldr-rise 720ms cubic-bezier(0.16, 1, 0.3, 1) forwards; animation-delay: calc(1450ms + var(--i) * 60ms); }
  .ldr__last { color: var(--red); }
  .ldr__line { font-size: 13px; font-weight: 600; letter-spacing: 0.32em; color: var(--steel); opacity: 0; animation: ldr-fade 600ms ease-out 1850ms forwards; }
  .ldr__skip { position: absolute; bottom: calc(24px + env(safe-area-inset-bottom)); left: 0; right: 0; text-align: center; font-size: 13px; color: #8A8E94; opacity: 0; animation: ldr-fade 400ms ease-out 900ms forwards; }

  /* 1. The outer ring draws itself as a circle. */
  .ldr .logo__ring { stroke-dasharray: 1; stroke-dashoffset: 1; animation: ldr-draw 820ms cubic-bezier(0.65, 0, 0.35, 1) 120ms forwards; }
  /* 2. The white plate fills the circle, then the red disc grows from its centre. */
  .ldr .logo__plate { transform-origin: 512px 512px; transform: scale(0.9); opacity: 0; animation: ldr-pop 560ms cubic-bezier(0.23, 1, 0.32, 1) 700ms forwards; }
  .ldr .logo__disc { --from: 0.55; transform-origin: 512px 500px; transform: scale(0.55); opacity: 0; animation: ldr-pop 640ms cubic-bezier(0.23, 1, 0.32, 1) 860ms forwards; }
  .ldr .logo__brush { stroke-dasharray: 1; stroke-dashoffset: 1; animation: ldr-draw 520ms cubic-bezier(0.23, 1, 0.32, 1) 1000ms forwards; }
  /* 3. The pagoda draws line by line, top to bottom; the roofs fill once drawn. */
  .ldr .logo__pagoda .draw { stroke-dasharray: 1; stroke-dashoffset: 1; animation: ldr-draw 460ms cubic-bezier(0.23, 1, 0.32, 1) forwards; animation-delay: calc(1050ms + var(--k) * 70ms); }
  .ldr .logo__roof { fill: #fff; fill-opacity: 0; animation: ldr-draw 460ms cubic-bezier(0.23, 1, 0.32, 1) forwards, ldr-fill 300ms ease-out forwards; animation-delay: calc(1050ms + var(--k) * 70ms), calc(1450ms + var(--k) * 50ms); }
  .ldr .logo__fin { opacity: 0; animation: ldr-fade 240ms ease-out 1180ms forwards; }
  /* 4. The texts settle along their arcs; the ground stroke stretches out. */
  .ldr .logo__top { transform-origin: 512px 512px; transform: rotate(-10deg); opacity: 0; animation: ldr-settle 700ms cubic-bezier(0.23, 1, 0.32, 1) 1250ms forwards; }
  .ldr .logo__bottom { transform-origin: 512px 512px; transform: rotate(10deg); opacity: 0; animation: ldr-settle 700ms cubic-bezier(0.23, 1, 0.32, 1) 1330ms forwards; }
  .ldr .logo__ground { transform-origin: 512px 740px; transform: scaleX(0.15); opacity: 0; animation: ldr-grow 560ms cubic-bezier(0.23, 1, 0.32, 1) 1500ms forwards; }

  @keyframes ldr-draw { to { stroke-dashoffset: 0; } }
  @keyframes ldr-grow { to { transform: none; opacity: 1; } }
  /* Solid almost at once, then keeps growing: no grey half-transparent disc on black. */
  @keyframes ldr-pop { 0% { transform: scale(var(--from, 0.88)); opacity: 0; } 22% { opacity: 1; } 100% { transform: none; opacity: 1; } }
  @keyframes ldr-fill { to { fill-opacity: 1; } }
  @keyframes ldr-fade { to { opacity: 1; } }
  @keyframes ldr-settle { to { transform: none; opacity: 1; } }
  @keyframes ldr-rise { to { transform: none; } }

  /* The hero's own entrance waits for the curtain, then plays as it lifts. */
  html.is-loading .seq__title [data-line], html.is-loading .seq [data-load] { animation-play-state: paused; }
</style>

<script>
  const html = document.documentElement;
  const ldr = document.querySelector<HTMLElement>('[data-loader]');
  if (ldr && html.classList.contains('is-loading')) {
    let done = false;
    const finish = () => {
      if (done) return;
      done = true;
      ldr.classList.add('is-leaving');
      html.classList.remove('is-loading');
      window.dispatchEvent(new Event('hk:intro-done'));
      events.forEach((e) => window.removeEventListener(e, finish));
      window.setTimeout(() => ldr.remove(), 820);
    };
    const events = ['pointerdown', 'keydown', 'wheel', 'touchstart'];
    events.forEach((e) => window.addEventListener(e, finish, { passive: true }));
    window.setTimeout(finish, 2450);
  } else {
    ldr?.remove(); // not playing this visit: keep the page clean
  }
</script>

{
  "routes": [
    {
      "route": "/_astro/*",
      "headers": {
        "cache-control": "public, max-age=31536000, immutable"
      }
    },
    {
      "route": "/frames/*",
      "headers": {
        "cache-control": "public, max-age=2592000"
      }
    },
    {
      "route": "/posters/*",
      "headers": {
        "cache-control": "public, max-age=2592000"
      }
    },
    {
      "route": "/video/*",
      "headers": {
        "cache-control": "public, max-age=2592000"
      }
    }
  ],
  "globalHeaders": {
    "X-Content-Type-Options": "nosniff",
    "Referrer-Policy": "strict-origin-when-cross-origin",
    "X-Frame-Options": "SAMEORIGIN"
  },
  "mimeTypes": {
    ".webp": "image/webp",
    ".mp4": "video/mp4"
  }
}
